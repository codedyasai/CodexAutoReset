<Window x:Class="CodexResetGuard.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CodexResetGuard"
        Icon="Assets/CodexResetGuard.ico"
        Width="800"
        Height="820"
        MinWidth="560"
        MinHeight="620"
        Background="{StaticResource AppBackgroundBrush}"
        Foreground="{StaticResource PrimaryTextBrush}"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        Closing="OnClosing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource AppBarBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="24,17">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Image Width="40"
                       Height="40"
                       Source="Assets/CodexResetGuard.ico"
                       Stretch="Uniform"
                       AutomationProperties.Name="CodexResetGuard 방패와 사용량 게이지 아이콘" />

                <StackPanel Grid.Column="1"
                            Margin="13,0,16,0"
                            VerticalAlignment="Center">
                    <TextBlock FontSize="18"
                               FontWeight="SemiBold"
                               Text="CodexResetGuard" />
                    <TextBlock Style="{StaticResource CaptionTextStyle}"
                               Text="주간 사용량과 초기화권을 한곳에서 관리합니다." />
                </StackPanel>

                <Border Grid.Column="2"
                        VerticalAlignment="Center"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="11,6">
                    <TextBlock FontSize="12"
                               FontWeight="SemiBold"
                               Text="{Binding AutomationStateText}" />
                </Border>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto"
                      Focusable="False">
            <Grid MaxWidth="920" Margin="28,26,28,34">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Style="{StaticResource CardBorderStyle}"
                        Padding="24"
                        Margin="0,0,0,14">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           Text="이번 주 남은 사용량" />
                                <TextBlock Margin="0,5,0,0"
                                           FontSize="42"
                                           FontWeight="SemiBold"
                                           Text="{Binding WeeklyRemainingText}" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    MinWidth="96"
                                    Margin="12,0,0,0"
                                    VerticalAlignment="Top"
                                    AutomationProperties.Name="주간 사용량 지금 새로고침"
                                    Content="새로고침"
                                    Click="OnRefreshClick" />
                        </Grid>

                        <ProgressBar Margin="0,18,0,10"
                                     Minimum="0"
                                     Maximum="100"
                                     Value="{Binding WeeklyRemainingPercent, Mode=OneWay}"
                                     AutomationProperties.Name="주간 남은 사용량 백분율"
                                     AutomationProperties.HelpText="0에서 100 사이의 주간 남은 사용량입니다." />
                        <TextBlock Style="{StaticResource CaptionTextStyle}"
                                   Text="{Binding WeeklyResetStatus}" />

                        <Border Margin="0,18,0,0"
                                Padding="12,10"
                                Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="9">
                            <TextBlock Text="{Binding OverallStatus}"
                                       TextWrapping="Wrap"
                                       LineHeight="21"
                                       AutomationProperties.LiveSetting="Polite" />
                        </Border>
                    </StackPanel>
                </Border>

                <Grid Grid.Row="1" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Style="{StaticResource CardBorderStyle}"
                            Padding="20">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CaptionTextStyle}"
                                       Text="사용 가능한 초기화권" />
                            <TextBlock Margin="0,7,0,0"
                                       FontSize="25"
                                       FontWeight="SemiBold"
                                       Text="{Binding CreditStatus}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2"
                            Style="{StaticResource CardBorderStyle}"
                            Padding="20">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CaptionTextStyle}"
                                       Text="마지막 확인" />
                            <TextBlock Margin="0,7,0,0"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Text="{Binding LastCheckedStatus}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Grid.Row="2"
                        Style="{StaticResource CardBorderStyle}"
                        Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeadingTextStyle}"
                                   Text="확인 설정" />
                        <TextBlock Margin="0,4,0,20"
                                   Style="{StaticResource CaptionTextStyle}"
                                   Text="앱이 주간 사용량을 확인하는 기준과 주기를 정합니다." />

                        <Label Padding="0"
                               FontWeight="SemiBold"
                               Target="{Binding ElementName=ThresholdInput}"
                               Content="잔여량 임계값" />
                        <TextBlock Margin="0,3,0,8"
                                   Style="{StaticResource CaptionTextStyle}"
                                   Text="주간 잔여량이 이 값 이하일 때 초기화 조건을 확인합니다. (1~100%)" />
                        <DockPanel LastChildFill="False">
                            <TextBox x:Name="ThresholdInput"
                                     Width="116"
                                     MaxLength="3"
                                     Text="{Binding ThresholdText, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="주간 잔여량 임계값" />
                            <TextBlock Margin="10,0,0,0"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold"
                                       Text="%" />
                        </DockPanel>

                        <Separator Margin="0,20"
                                   Background="{StaticResource BorderBrush}" />

                        <Label Padding="0"
                               FontWeight="SemiBold"
                               Target="{Binding ElementName=PollIntervalInput}"
                               Content="확인 주기" />
                        <TextBlock Margin="0,3,0,8"
                                   Style="{StaticResource CaptionTextStyle}"
                                   Text="사용량을 다시 확인할 간격입니다. 확인 자체는 모델 토큰을 사용하지 않습니다. (1~60분)" />
                        <DockPanel LastChildFill="False">
                            <TextBox x:Name="PollIntervalInput"
                                     Width="116"
                                     MaxLength="2"
                                     Text="{Binding PollIntervalText, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="사용량 확인 주기" />
                            <TextBlock Margin="10,0,0,0"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold"
                                       Text="분" />
                        </DockPanel>

                        <Separator Margin="0,20"
                                   Background="{StaticResource BorderBrush}" />

                        <CheckBox IsChecked="{Binding StartWithWindows}"
                                  AutomationProperties.Name="Windows 로그인 시 자동 실행"
                                  Content="Windows 로그인 시 자동 실행" />
                        <TextBlock Margin="22,5,0,0"
                                   Style="{StaticResource CaptionTextStyle}"
                                   Text="{Binding StartupStatusText}" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="3"
                        Style="{StaticResource CardBorderStyle}"
                        Margin="0,0,0,14">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,18,0">
                                <TextBlock Style="{StaticResource SectionHeadingTextStyle}"
                                           Text="자동 초기화" />
                                <TextBlock Margin="0,4,0,0"
                                           Style="{StaticResource CaptionTextStyle}"
                                           Text="꺼져 있어도 사용량은 계속 확인합니다." />
                            </StackPanel>
                            <CheckBox Grid.Column="1"
                                      VerticalAlignment="Center"
                                      IsChecked="{Binding AutomationEnabled}"
                                      Style="{StaticResource ToggleSwitchStyle}"
                                      AutomationProperties.Name="자동 초기화"
                                      AutomationProperties.HelpText="켜면 임계값 도달 시 초기화권을 사용할 수 있습니다." />
                        </Grid>

                        <Border Margin="0,18,0,0"
                                Padding="14,12"
                                Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10">
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold"
                                           Text="초기화권이 실제로 사용될 수 있습니다." />
                                <TextBlock Margin="0,5,0,0"
                                           Style="{StaticResource CaptionTextStyle}"
                                           Text="자동 초기화를 켜고 저장하면, 현재 주간 잔여량이 임계값 이하인 경우 초기화권 1개가 바로 사용될 수 있습니다. 실제 초기화 범위는 서버가 결정합니다." />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Row="4">
                    <TextBlock MinHeight="22"
                               Margin="2,0,2,10"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               Text="{Binding SaveStatus}"
                               TextWrapping="Wrap"
                               AutomationProperties.LiveSetting="Polite" />
                    <WrapPanel HorizontalAlignment="Right">
                        <Button Margin="0,0,8,0"
                                Content="지금 새로고침"
                                AutomationProperties.Name="사용량 지금 새로고침"
                                Click="OnRefreshClick" />
                        <Button Margin="0,0,8,0"
                                Content="설정 저장"
                                IsDefault="True"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="OnSaveClick" />
                        <Button Content="창 숨기기"
                                IsCancel="True"
                                Click="OnHideClick" />
                    </WrapPanel>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
